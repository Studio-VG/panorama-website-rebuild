# Demo password for /admin. Change this before any public deployment.
# The app falls back to this same demo value when ADMIN_PASSWORD is unset,
# so local preview works without copying this file.
ADMIN_PASSWORD=byvaso-demo

# Optional. Signs the admin cookie. If empty, the password is used as the key.
# Set a long random string in production. This example is not a real secret.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public site origin used in canonical URLs, the sitemap, and JSON-LD.
# SITE_URL=https://example.com

# On Vercel the filesystem cannot keep admin edits. Set this to a Postgres or
# MySQL URL (postgres:// or mysql://) and saves go to the studio_document table.
# Leave it unset locally: a normal PHP server writes data/store.json instead.
# DATABASE_URL=postgres://user:pass@host:5432/studio

# Optional registration delivery. If these are unset, codes are not emailed
# or texted. Unused codes are shown on /admin until they are used.
# RESEND_API_KEY=
# RESEND_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
