# Demo password for /admin. Change this before any public deployment.
# The app falls back to this same demo value when ADMIN_PASSWORD is unset,
# so local preview works without copying this file.
ADMIN_PASSWORD=byvaso-demo

# Optional. Signs the admin cookie. If empty, the password is used as the key.
# Set a long random string in production. This example is not a real secret.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public site origin used in canonical URLs, the sitemap, and JSON-LD.
# SITE_URL=https://example.com
